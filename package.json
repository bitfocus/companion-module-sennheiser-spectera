{
	"name": "sennheiser-spectera",
	"version": "1.4.0-beta.3",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"format:check": "prettier -c .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run --typecheck.enabled",
		"test:live": "vitest run --typecheck.enabled tests/integration/live-device.spec.ts",
		"test:watch": "vitest --typecheck.enabled",
		"test:coverage": "vitest run --typecheck.enabled --coverage",
		"check": "run format:check && run lint && run test"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-sennheiser-spectera.git"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "^2.1.3",
		"p-queue": "^9.3.5",
		"undici": "^8.12.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^4.1.12"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
